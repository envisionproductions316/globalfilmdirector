{
  "name": "global-film-director",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ensure-next-cache.mjs",
    "prebuild": "node scripts/ensure-next-cache.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/continuity.test.ts lib/timeline.test.ts",
    "check": "node scripts/check-ready.mjs",
    "ready": "npm run typecheck && npm test && npm run build && npm run check"
  },
  "dependencies": {
    "next": "^15.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
