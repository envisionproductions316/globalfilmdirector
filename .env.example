# Optional OpenAI-compatible Director LLM (falls back to local Studio Director)
# OPENAI_API_KEY=
# DIRECTOR_API_KEY=
# DIRECTOR_BASE_URL=https://api.openai.com/v1
# DIRECTOR_MODEL=gpt-4o-mini

# Optional public origin for phone QR links (e.g. http://192.168.1.20:5180)
# CAPTURE_PUBLIC_ORIGIN=

# Unified web ↔ desktop auth via Envision Cloud OIDC (authorization code + PKCE).
# No custom password DB in GFD. Auth ≠ cloud project sync.
# Start Envision Cloud with identity configured (local-loopback or Supabase), then:
# AUTH_ISSUER=http://127.0.0.1:8000
# AUTH_CLIENT_ID=gfd-web
# AUTH_DESKTOP_CLIENT_ID=gfd-desktop
# AUTH_CLIENT_SECRET=   # omit on local HTTP (gfd-web is public+PKCE); required when Envision uses HTTPS secret
# NEXT_PUBLIC_AUTH_ISSUER=http://127.0.0.1:8000
# NEXT_PUBLIC_AUTH_CLIENT_ID=gfd-web
# Defaults (when issuer is set): /oauth/authorize · /oauth/token · client gfd-web
# NEXT_PUBLIC_AUTH_AUTHORIZATION_ENDPOINT=
# NEXT_PUBLIC_AUTH_TOKEN_ENDPOINT=
# NEXT_PUBLIC_AUTH_END_SESSION_ENDPOINT=
# NEXT_PUBLIC_AUTH_REDIRECT_URI=http://127.0.0.1:5180/auth/callback
# NEXT_PUBLIC_AUTH_SCOPES=openid profile email offline_access
# NEXT_PUBLIC_AUTH_PASSWORD_RESET_URL=http://127.0.0.1:8000/#signin
# NEXT_PUBLIC_AUTH_EMAIL_VERIFY_URL=http://127.0.0.1:8000/#signin
# Desktop tokens use Electron safeStorage. See docs/PHASE5B_VERIFICATION.md.
# AUTH_REQUIRE_SAFE_STORAGE=1  # refuse desktop sign-in if OS encryption is unavailable
# If Envision binds the wrong port, a shell PORT=… overrides .env — set PORT=8000 explicitly.
